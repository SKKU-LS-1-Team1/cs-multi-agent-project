# 복사해서 .env 로 쓴다. .env 는 git에 올리지 않는다.
APP_ENV=local

# live: Jev + Gemini 호출 / 그 밖의 값: LLM 끔 (키 없이 개발할 때)
LLM_PROVIDER=fake
GEMINI_API_KEY=
JEV_API_KEY=
JEV_BASE_URL=https://inference.do-ai.run/v1

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# docker compose 밖에서 띄울 때만 채운다 (compose 안에서는 docker-compose.yml 값을 쓴다)
DATABASE_URL=
REDIS_URL=
CHROMA_HOST=
