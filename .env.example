# 복사해서 .env 로 쓴다. .env 는 git에 올리지 않는다.
APP_ENV=local

# live: Jev + Gemini 호출 / 그 밖의 값: LLM 끔 (키 없이 개발할 때)
LLM_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.7-flash
GEMINI_MODEL_WRITER=gemini-3.7-flash
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest
# Jev 확신도 기준 (CSA-49 에서 확정)
JEV_MIN_CONFIDENCE=0.7

# 임베딩 (CSA-18). 바꾸면 docs·cases 를 전부 다시 적재해야 한다
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=1536

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# docker compose 밖에서 띄울 때만 채운다 (compose 안에서는 docker-compose.yml 값을 쓴다)
DATABASE_URL=
REDIS_URL=

# 처리 흐름
MAX_VERIFY_RETRIES=2
SLA_AT_RISK_RATIO=0.75
