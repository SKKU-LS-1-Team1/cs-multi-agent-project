# 복사해서 .env 로 쓴다. .env 는 git에 올리지 않는다.
APP_ENV=local
# VM 의 도메인 (CSA-46). 비우면 nginx 가 HTTP 로 뜬다 (로컬). 예: luckystar-global-cs.com
DOMAIN=

# live: Jev + Gemini 호출 / 그 밖의 값: LLM 끔 (키 없이 개발할 때)
LLM_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.7-flash
GEMINI_MODEL_WRITER=gemini-3.7-flash
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest
# Jev 확신도 기준 (CSA-49 에서 확정)
JEV_MIN_CONFIDENCE=0.7
# 근거 확정 reranker (CSA-81). 판단 모델이 docs 후보마다 "문의에 답하는 절인가" 를 다시 본다
# 비교: uv run python -m cs_agent.agents.retrieval --split valid --rerank
RERANK_ENABLED=true
RERANK_WEIGHT=0.5
# 1차 검색 키워드+벡터 하이브리드 (멘토링 개선안 4). 모델명·에러코드·규격명 일치 점수를 더한다
# 비교: uv run python -m cs_agent.agents.retrieval --split valid --hybrid
HYBRID_ENABLED=false
HYBRID_WEIGHT=0.3
# 같은 요청 캐시(초, 0 이면 끔)·분당 호출 상한(0 이면 제한 없음) — CSA-45, live 일 때만
LLM_CACHE_TTL_S=86400
GEMINI_RPM=0
JEV_RPM=0
LLM_RATE_WAIT_S=20

# 임베딩 (CSA-18). 바꾸면 docs·cases 를 전부 다시 적재해야 한다
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=1536

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# docker compose 밖에서(uv run) 띄울 때 쓴다. compose 안의 api 는 docker-compose.yml 값을 쓴다.
# DB 만 띄우기: docker compose up -d postgres → 아래 주소로 접속 (포트는 POSTGRES_PORT)
DATABASE_URL=postgresql+psycopg://cs:cs@localhost:55432/cs
POSTGRES_PORT=55432
REDIS_URL=

# 처리 흐름
MAX_VERIFY_RETRIES=2
SLA_AT_RISK_RATIO=0.75
ANALYSIS_RETRY_INTERVAL_S=60
# 상담원용 원문 번역 대기 상한. 초과해도 문의 처리는 계속 진행
INQUIRY_TRANSLATION_TIMEOUT_S=20
# 벡터 없이 저장된 해결 사례 임베딩 간격 (초, live·DB 일 때). 0 이면 끔
CASE_EMBED_INTERVAL_S=300

# 사례 학습 지식 그래프 (CSA-69). false 면 지금처럼 패턴 DB(case_patterns)로 사례를 찾는다.
# Neo4j 만 띄우기: docker compose up -d neo4j → Browser http://localhost:7474 (아래 계정)
# 적재: embed_docs 다음에 python -m cs_agent.pipeline.build_graph (README)
GRAPH_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cs-graph-local

# Customer inquiry history search (live + PostgreSQL)
CUSTOMER_HISTORY_ENABLED=true
# Must match the customer profile used by the demo form; not an authentication mechanism.
WEB_DEMO_CUSTOMER_ID=CUST-0557
